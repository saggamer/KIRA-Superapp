{
  "name": "kira-diagonal-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persistent Playwright browser MCP for Kira",
  "scripts": {
    "start": "node server.mjs",
    "desktop": "electron desktop.mjs",
    "mcp-config": "node print_mcp_config.mjs",
