#!/bin/zsh
set -u

SCRIPT_PATH="${0:A}"
APP_DIR="${KIRA_SUPERAPP_HOME:-$(cd "$(dirname "$SCRIPT_PATH")" && pwd)}"
PYTHON="$APP_DIR/.venv/bin/python"

if [[ ! -x "$PYTHON" ]]; then
  echo "[KIRA SUPERAPP] Runtime missing: $PYTHON" >&2
  exit 1
fi

if [[ ! -f "$APP_DIR/interface.py" || ! -f "$APP_DIR/ui.html" ]]; then
  echo "[KIRA SUPERAPP] App files are missing from $APP_DIR" >&2
  exit 1
fi

echo "[KIRA SUPERAPP] Launching..."
exec "$PYTHON" "$APP_DIR/interface.py"
